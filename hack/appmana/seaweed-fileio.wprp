<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed 16 MiB event ring; no CPU sampling or per-read/write stacks.
     Capture process identities, file names, I/O operations and completions.
     Memory mode retains recent history, not an unlimited complete recording. -->
<WindowsPerformanceRecorder Version="1.0" Author="AppMana">
  <Profiles>
    <SystemCollector Id="SeaweedCollector" Name="NT Kernel Logger">
      <BufferSize Value="256" />
      <Buffers Value="64" />
    </SystemCollector>
    <SystemProvider Id="SeaweedFileIOProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
      </Keywords>
    </SystemProvider>
    <Profile Id="SeaweedFileIO.Verbose.Memory" Name="SeaweedFileIO" Description="SeaweedFS lab file I/O diagnosis" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SeaweedCollector">
          <SystemProviderId Value="SeaweedFileIOProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
