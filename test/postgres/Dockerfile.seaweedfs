# go.mod replaces go-fuse with a sibling checkout outside any Docker build
# context, so the binaries are built on the host into bin/ (see
# .github/workflows/postgres-tests.yml) and copied in here.
FROM alpine:latest

# Install ca-certificates for HTTPS calls and netcat for health checks
RUN apk --no-cache add ca-certificates netcat-openbsd curl

WORKDIR /root/

COPY bin/weed bin/weed-db ./

# Make it executable
RUN chmod +x ./weed ./weed-db

# Expose ports
EXPOSE 9333 8888 8333 8085 9533 5432

# Create data directory
RUN mkdir -p /data

# Default command (can be overridden)
CMD ["./weed", "server", "-dir=/data"]
